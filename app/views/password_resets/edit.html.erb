<% content_for :title, "Nueva contraseña — AppMyLife" %>

<p class="bpa-eyebrow">Seguridad de la cuenta</p>
<h1 class="bpa-auth-title">Nueva contraseña.</h1>
<p class="bpa-auth-subtitle">Elige una nueva clave para la cuenta de <strong><%= @user.email %></strong>.</p>

<%= form_with url: password_reset_path(token: @token), method: :patch, class: "bpa-auth-form" do %>
  <div class="bpa-auth-field">
    <div class="bpa-auth-label-row">
      <label class="bpa-auth-label" for="new-password">Nueva contraseña</label>
      <span class="bpa-strength-label" data-auth-form-target="strengthLabel">Mínimo 6 caracteres</span>
    </div>

    <div class="bpa-password-wrap">
      <input
        id="new-password"
        type="password"
        name="password"
        autocomplete="new-password"
        placeholder="Escribe tu nueva contraseña"
        required
        minlength="6"
        autofocus
        class="bpa-auth-input bpa-auth-input--password"
        data-auth-form-target="password"
        data-action="input->auth-form#evaluateStrength"
      >
      <button
        type="button"
        class="bpa-eye-btn"
        data-action="click->auth-form#togglePassword"
        aria-label="Mostrar contraseña"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>

    <div class="bpa-strength-bars" aria-hidden="true">
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
    </div>
  </div>

  <div class="bpa-auth-field">
    <div class="bpa-auth-label-row">
      <label class="bpa-auth-label" for="new-password-confirmation">Confirmar nueva contraseña</label>
      <span class="bpa-match-hint" data-auth-form-target="matchHint"></span>
    </div>

    <div class="bpa-password-wrap">
      <input
        id="new-password-confirmation"
        type="password"
        name="password_confirmation"
        autocomplete="new-password"
        placeholder="Repite tu nueva contraseña"
        required
        minlength="6"
        class="bpa-auth-input bpa-auth-input--password"
        data-auth-form-target="confirmation"
        data-action="input->auth-form#checkMatch"
      >
      <button
        type="button"
        class="bpa-eye-btn"
        data-action="click->auth-form#togglePassword"
        aria-label="Mostrar contraseña"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>
  </div>

  <button type="submit" class="bpa-auth-submit">
    <span>Guardar nueva contraseña y entrar</span>
    <%= bpa_icon("arrow", size: 18) %>
  </button>
<% end %>
