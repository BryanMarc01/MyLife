<% content_for :title, "Crear cuenta — AppMyLife" %>

<p class="bpa-eyebrow">Una chispa. Todo en orden.</p>
<h1 class="bpa-auth-title">Crea tu cuenta.</h1>
<p class="bpa-auth-subtitle">Tu espacio privado para ideas, tareas y movimientos.</p>

<% if @user.errors.any? %>
  <div class="bpa-auth-alert">
    <%= @user.errors.full_messages.to_sentence %>
  </div>
<% end %>

<%= form_with model: @user, url: signup_path, method: :post, class: "bpa-auth-form" do |f| %>
  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_name">Tu nombre</label>
    <%= f.text_field :name, placeholder: "Ej. Alex", required: true, autofocus: true, class: "bpa-auth-input" %>
  </div>

  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_email">Correo electrónico</label>
    <%= f.email_field :email, placeholder: "tu@correo.com", required: true, class: "bpa-auth-input" %>
  </div>

  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_password">Contraseña (mínimo 6 caracteres)</label>
    <%= f.password_field :password, placeholder: "••••••••", required: true, minlength: 6, class: "bpa-auth-input" %>
  </div>

  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_password_confirmation">Confirmar contraseña</label>
    <%= f.password_field :password_confirmation, placeholder: "••••••••", required: true, minlength: 6, class: "bpa-auth-input" %>
  </div>

  <button type="submit" class="bpa-auth-submit">
    <span>Crear mi cuenta</span>
    <%= bpa_icon("arrow", size: 18) %>
  </button>
<% end %>

<p class="bpa-auth-footer">
  ¿Ya tienes cuenta?
  <%= link_to "Iniciar sesión", login_path, class: "bpa-auth-link" %>
</p>
