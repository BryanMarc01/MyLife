<% content_for :title, "Crear cuenta — AppMyLife" %>

<p class="bpa-eyebrow">Una chispa. Todo en orden.</p>
<h1 class="bpa-auth-title">Crea tu cuenta.</h1>
<p class="bpa-auth-subtitle">Tu espacio privado para ideas, tareas y movimientos.</p>

<% if @user.errors.any? %>
  <div class="bpa-auth-alert">
    <%= @user.errors.full_messages.to_sentence %>
  </div>
<% end %>

<%= form_with model: @user, url: signup_path, method: :post, class: "bpa-auth-form" do |f| %>
  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_name">Tu nombre</label>
    <%= f.text_field :name, placeholder: "Ej. Alex", autocomplete: "name", required: true, autofocus: true, class: "bpa-auth-input" %>
  </div>

  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="user_email">Correo electrónico</label>
    <%= f.email_field :email, placeholder: "tu@correo.com", autocomplete: "email", required: true, class: "bpa-auth-input" %>
  </div>

  <div class="bpa-auth-field">
    <div class="bpa-auth-label-row">
      <label class="bpa-auth-label" for="user_password">Contraseña</label>
      <span class="bpa-strength-label" data-auth-form-target="strengthLabel">Mínimo 6 caracteres</span>
    </div>

    <div class="bpa-password-wrap">
      <%= f.password_field :password,
            placeholder: "Crea una contraseña segura",
            autocomplete: "new-password",
            required: true,
            minlength: 6,
            class: "bpa-auth-input bpa-auth-input--password",
            data: {
              auth_form_target: "password",
              action: "input->auth-form#evaluateStrength"
            } %>
      <button
        type="button"
        class="bpa-eye-btn"
        data-action="click->auth-form#togglePassword"
        aria-label="Mostrar contraseña"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>

    <div class="bpa-strength-bars" aria-hidden="true">
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
      <span class="bpa-strength-bar" data-auth-form-target="strengthBar"></span>
    </div>
  </div>

  <div class="bpa-auth-field">
    <div class="bpa-auth-label-row">
      <label class="bpa-auth-label" for="user_password_confirmation">Confirmar contraseña</label>
      <span class="bpa-match-hint" data-auth-form-target="matchHint"></span>
    </div>

    <div class="bpa-password-wrap">
      <%= f.password_field :password_confirmation,
            placeholder: "Repite tu contraseña",
            autocomplete: "new-password",
            required: true,
            minlength: 6,
            class: "bpa-auth-input bpa-auth-input--password",
            data: {
              auth_form_target: "confirmation",
              action: "input->auth-form#checkMatch"
            } %>
      <button
        type="button"
        class="bpa-eye-btn"
        data-action="click->auth-form#togglePassword"
        aria-label="Mostrar contraseña"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>
  </div>

  <label class="bpa-remember-row">
    <input type="checkbox" name="remember_me" value="1" checked class="bpa-remember-checkbox">
    <span>Mantener mi sesión iniciada en este dispositivo</span>
  </label>

  <button type="submit" class="bpa-auth-submit">
    <span>Crear mi cuenta</span>
    <%= bpa_icon("arrow", size: 18) %>
  </button>
<% end %>

<p class="bpa-auth-footer">
  ¿Ya tienes cuenta?
  <%= link_to "Iniciar sesión", login_path, class: "bpa-auth-link" %>
</p>
