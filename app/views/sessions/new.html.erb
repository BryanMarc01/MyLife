<% content_for :title, "Iniciar sesión — AppMyLife" %>

<p class="bpa-eyebrow">Bitácora personal privada</p>
<h1 class="bpa-auth-title">Hola de nuevo.</h1>
<p class="bpa-auth-subtitle">Accede a tus ideas, tareas y finanzas privadas.</p>

<!-- Botones de Acceso Rápido (Google / GitHub) -->
<div class="bpa-social-buttons">
  <button
    type="button"
    class="bpa-social-btn"
    data-provider="google"
    data-action="click->auth-form#openSocial"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82Z"/>
      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24Z"/>
      <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09Z"/>
      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96Z"/>
    </svg>
    <span>Google</span>
  </button>

  <button
    type="button"
    class="bpa-social-btn"
    data-provider="github"
    data-action="click->auth-form#openSocial"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.92.58.11.79-.25.79-.56v-2.01c-3.2.7-3.88-1.39-3.88-1.39-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.78 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
    </svg>
    <span>GitHub</span>
  </button>
</div>

<div class="bpa-auth-divider">
  <span>o entra con tu correo</span>
</div>

<%= form_with url: login_path, method: :post, class: "bpa-auth-form" do %>
  <div class="bpa-auth-field">
    <label class="bpa-auth-label" for="login-email">Correo electrónico</label>
    <input
      id="login-email"
      type="email"
      name="email"
      autocomplete="email"
      value="<%= params[:email] %>"
      placeholder="tu@correo.com"
      required
      autofocus
      class="bpa-auth-input"
    >
  </div>

  <div class="bpa-auth-field">
    <div class="bpa-auth-label-row">
      <label class="bpa-auth-label" for="login-password">Contraseña</label>
      <%= link_to "¿Olvidaste tu contraseña?", forgot_password_path, class: "bpa-forgot-link" %>
    </div>

    <div class="bpa-password-wrap">
      <input
        id="login-password"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="••••••••"
        required
        class="bpa-auth-input bpa-auth-input--password"
      >
      <button
        type="button"
        class="bpa-eye-btn"
        data-action="click->auth-form#togglePassword"
        aria-label="Mostrar contraseña"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>
  </div>

  <label class="bpa-remember-row">
    <input type="checkbox" name="remember_me" value="1" checked class="bpa-remember-checkbox">
    <span>Mantener mi sesión iniciada en este dispositivo</span>
  </label>

  <button type="submit" class="bpa-auth-submit">
    <span>Entrar a mi bitácora</span>
    <%= bpa_icon("arrow", size: 18) %>
  </button>
<% end %>

<p class="bpa-auth-footer">
  ¿Todavía no tienes cuenta?
  <%= link_to "Crear cuenta gratis", signup_path, class: "bpa-auth-link" %>
</p>
